{
	"name": "root",
	"private": true,
	"workspaces": ["packages/*"],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"overrides": {
		"js-yaml": "^4.3.2",
		"pacote": "^21.5.1",
		"smol-toml": "^1.8.0"
	},
	"scripts": {
		"release:version": "lerna version --conventional-commits",
		"publish": "npm run build && lerna publish from-package --yes",
		"format": "biome format --write .",
		"format:ci": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"export": "lerna run export",
		"build": "lerna run build",
		"build:docs": "lerna run build:docs && typedoc",
		"build:all": "npm run build && npm run build:docs",
		"pretest": "npm run build",
		"test": "lerna run test",
		"test:lua": "lerna run test:lua",
		"test:dcs:mission": "npm run test:dcs --workspace=@flying-dice/tslua-dcs-mission-types-test",
		"test:dcs:gui": "npm run test:dcs --workspace=@flying-dice/tslua-dcs-gui-types-test",
		"test:dcs": "npm run test:dcs:mission && npm run test:dcs:gui",
		"audit:dcs-types": "tsx scripts/audit-dcs-type-coverage.ts",
		"posttest": "npm run build:docs"
	},
	"dependencies": {
		"lua-types": "^2.14.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"lerna": "^10.0.1",
		"nodemon": "^3.1.14",
		"npm-check-updates": "^22.2.9",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typedoc": "^0.28.20",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"nx@23.2.1": true
	}
}

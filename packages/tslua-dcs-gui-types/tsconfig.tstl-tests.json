{
	"$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/refs/tags/v1.37.1/tsconfig-schema.json",
	"extends": ["./tsconfig.tstl.json"],
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["tests/doubles/**/*", "tests/export/index.ts"],
	"compilerOptions": {
		"outDir": ".test",
		"declaration": false,
		"rootDir": "."
	},
	"tstl": {
		"luaTarget": "5.1",
		"luaBundleEntry": "tests/index.ts",
		"luaBundle": "tests.lua"
	}
}

{
	"name": "@flying-dice/tslua-http-api",
	"version": "0.33.0",
	"description": "LUA HTTP API Server written in Typescript Transpiled to lua using TypeScriptToLua",
	"keywords": [
		"lua",
		"http",
		"api"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"dev": "cd dist && lua51 test-app.lua",
		"dev:watch": "nodemon -e ts --watch src --exec \"npm run build && npm run dev\"",
		"build:docs": "typedoc",
		"test": "npm run test:lua",
		"test:lua": "tstl -p tsconfig.tstl-tests.json && lua51 ./.test/tests.lua"
	},
	"dependencies": {
		"@flying-dice/tslua-common": "^0.33.0",
		"@flying-dice/tslua-http": "^0.33.0",
		"@flying-dice/tslua-json": "^0.33.0"
	},
	"devDependencies": {
		"@flying-dice/tslua-luatest": "^0.33.0",
		"lua-types": "^2.14.1",
		"typescript": "6.0.3",
		"typescript-to-lua": "^1.37.1"
	},
	"gitHead": "a6ae4c01c5f5796bcc1c0e88d4b790d83de03340"
}

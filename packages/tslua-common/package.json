{
	"name": "@flying-dice/tslua-common",
	"version": "0.33.0",
	"description": "Common Utils Library",
	"keywords": [
		"lua",
		"dcs",
		"logger"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"build:docs": "typedoc",
		"test": "npm run test:lua",
		"test:lua": "tstl -p tsconfig.tstl-tests.json && lua51 --preload tests/doubles/dcs-env.lua ./.test/tests.lua"
	},
	"devDependencies": {
		"@flying-dice/tslua-luatest": "^0.33.0",
		"lua-types": "^2.14.1",
		"typescript": "6.0.2",
		"typescript-to-lua": "^1.37.1"
	},
	"gitHead": "a6ae4c01c5f5796bcc1c0e88d4b790d83de03340"
}

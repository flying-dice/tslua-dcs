{
	"$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/refs/tags/v1.37.1/tsconfig-schema.json",
	"extends": "../tsconfig.base.tstl.json",
	"include": ["doubles/**/*.ts"],
	"compilerOptions": {
		"declaration": false,
		"outDir": "dist",
		"rootDir": ".",
		"types": [
			"lua-types/5.1",
			"@typescript-to-lua/language-extensions",
			"@flying-dice/tslua-dcs-mission-types"
		]
	},
	"tstl": {
		"luaTarget": "5.1",
		"luaBundleEntry": "doubles/index.ts",
		"luaBundle": "dcs-mission-doubles.lua"
	}
}

{
	"name": "@flying-dice/tslua-dcs-mission-types",
	"version": "0.33.0",
	"description": "Typescript type definitions for DCS",
	"keywords": [
		"lua",
		"dcs",
		"mission"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rimraf dist",
		"export": "tsx scripts/export.ts",
		"typecheck:export": "tsc -p tsconfig.export.json",
		"test:export": "vitest run scripts --passWithNoTests",
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"test": "vitest run --coverage --passWithNoTests"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.20.4",
		"fs-extra": "^11.4.0",
		"lua-types": "^2.14.1",
		"typescript": "6.0.2",
		"typescript-to-lua": "^1.37.1"
	}
}

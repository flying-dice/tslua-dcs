{
	"name": "@flying-dice/tslua-base64",
	"version": "0.33.0",
	"description": "Base64 (RFC 4648) encoding and decoding for TypeScriptToLua, written in TypeScript and compatible with Lua 5.1 / DCS World",
	"keywords": [
		"lua",
		"dcs",
		"base64"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"build:docs": "typedoc",
		"test": "npm run test:lua",
		"test:lua": "tstl -p tsconfig.tstl-tests.json && lua51 ./.test/tests.lua",
		"generate:corpus": "node ./scripts/generate-corpus.mjs"
	},
	"devDependencies": {
		"@flying-dice/tslua-lua51": "^0.33.0",
		"@flying-dice/tslua-luatest": "^0.33.0",
		"lua-types": "^2.14.1",
		"typescript": "7.0.2",
		"typescript-to-lua": "^1.37.1"
	},
	"gitHead": "a6ae4c01c5f5796bcc1c0e88d4b790d83de03340"
}

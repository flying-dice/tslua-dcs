{
	"name": "@flying-dice/tslua-dcs-bridge",
	"version": "0.33.0",
	"description": "Project bridge into a running DCS World: JSON-RPC eval in the GUI and mission Lua environments, built on this repository's own HTTP stack",
	"private": true,
	"license": "ISC",
	"type": "module",
	"bin": {
		"dcs-bridge": "./scripts/dcs-bridge.mjs"
	},
	"scripts": {
		"build": "rimraf dist && tstl -p tsconfig.gui.json && tstl -p tsconfig.mission.json && node scripts/build-mission.mjs",
		"test": "npm run test:lua && node --test ./tests/cli.test.mjs",
		"test:lua": "tstl -p tsconfig.tests.json && lua51 ./.test/tests.lua"
	},
	"dependencies": {
		"@flying-dice/tslua-http": "^0.33.0",
		"@flying-dice/tslua-http-api": "^0.33.0",
		"@flying-dice/tslua-json": "^0.33.0"
	},
	"devDependencies": {
		"@flying-dice/tslua-dcs-gui-types": "^0.33.0",
		"@flying-dice/tslua-dcs-mission-types": "^0.33.0",
		"@flying-dice/tslua-lua51": "^0.33.0",
		"@flying-dice/tslua-luatest": "^0.33.0",
		"lua-types": "^2.14.1",
		"typescript": "7.0.2",
		"typescript-to-lua": "^1.37.1"
	}
}

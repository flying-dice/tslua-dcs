{
	"name": "@flying-dice/tslua-json",
	"version": "0.33.0",
	"description": "JSON (RFC 8259) encoding and decoding for TypeScriptToLua, written in TypeScript and compatible with Lua 5.1 / DCS World",
	"keywords": [
		"lua",
		"dcs",
		"json"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"build:docs": "typedoc",
		"test": "npm run test:lua",
		"test:lua": "tstl -p tsconfig.tstl-tests.json && lua51 ./.test/tests.lua",
		"generate:corpus": "node ./scripts/generate-corpus.mjs"
	},
	"devDependencies": {
		"@flying-dice/tslua-lua51": "^0.33.0",
		"@flying-dice/tslua-luatest": "^0.33.0",
		"lua-types": "^2.14.1",
		"typescript": "6.0.3",
		"typescript-to-lua": "^1.37.1"
	}
}

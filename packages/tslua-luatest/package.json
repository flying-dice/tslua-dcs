{
	"name": "@flying-dice/tslua-luatest",
	"version": "0.33.0",
	"description": "tslua testing library",
	"keywords": [
		"lua",
		"dcs",
		"test"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/flying-dice/tslua-dcs.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "ISC",
	"types": "./dist/index.d.ts",
	"main": "./dist/index",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.tstl.json && tstl -p tsconfig.tstl.json",
		"build:docs": "typedoc",
		"test": "vitest run --coverage"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.11",
		"lua-types": "^2.14.1",
		"typescript": "6.0.2",
		"typescript-to-lua": "^1.37.1",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^5.1.1"
	},
	"gitHead": "a6ae4c01c5f5796bcc1c0e88d4b790d83de03340"
}
